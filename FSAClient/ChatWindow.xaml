<Window x:Class="FSAClient.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSAClient"
        mc:Ignorable="d"
        Title="ChatWindow" Height="450" Width="800">
    <Grid Background="#FFE6EFED">
        <TextBox HorizontalAlignment="Left" Height="39" Margin="0,395,0,0" TextWrapping="Wrap" Text="Hello there" VerticalAlignment="Top" Width="750"/>
        <Button Content="Send" HorizontalAlignment="Left" Height="39" Margin="750,395,0,0" VerticalAlignment="Top" Width="50" Click="Button_Click"/>
        <Label x:Name="ConnectedUserName" Content="UserName" HorizontalAlignment="Center" Height="45" VerticalAlignment="Top" Width="337" HorizontalContentAlignment="Center" FontSize="20"/>
        <Label Content="IP:" HorizontalAlignment="Left" Height="27" Margin="10,41,0,0" VerticalAlignment="Top" Width="28"/>
        <Label Content="Port:" HorizontalAlignment="Left" Height="31" Margin="84,41,0,0" VerticalAlignment="Top" Width="43"/>
        <ListView HorizontalAlignment="Left" Height="298" Margin="10,0,0,0" VerticalAlignment="Center" Width="765" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
