<Window x:Class="FSAClient.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSAClient"
        mc:Ignorable="d"
        Title="ChatWindow" Height="450" Width="800">
    <Grid Background="#FFE6EFED">
        <TextBox x:Name="TextBoxMessage" HorizontalAlignment="Left" Height="38" Margin="10,358,0,0" TextWrapping="Wrap" Text="Hello there" VerticalAlignment="Top" Width="717"/>
        <Button Content="Send" HorizontalAlignment="Left" Height="39" Margin="732,358,0,0" VerticalAlignment="Top" Width="50" Click="ButtonSendMessage_Click" RenderTransformOrigin="0.54,-0.384"/>
        <Label x:Name="ConnectedUserName" Content="UserName" HorizontalAlignment="Center" Height="45" VerticalAlignment="Top" Width="337" HorizontalContentAlignment="Center" FontSize="20"/>
        <Label x:Name="IPLabel" Content="IP:" HorizontalAlignment="Left" Height="28" Margin="18,81,0,0" VerticalAlignment="Top" Width="28"/>
        <Label x:Name="PortLabel" Content="Port:" HorizontalAlignment="Left" Height="31" Margin="141,81,0,0" VerticalAlignment="Top" Width="42"/>
        <ListView ItemsSource="{Binding Messages}" HorizontalAlignment="Center" Height="181" VerticalAlignment="Center" Width="764">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Messages" DisplayMemberBinding="{Binding}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Label x:Name="IpContent"  HorizontalAlignment="Left" Height="26" Margin="51,83,0,0" VerticalAlignment="Top" Width="62"/>
        <Label x:Name="PortContent" HorizontalAlignment="Left" Height="31" Margin="199,81,0,0" VerticalAlignment="Top" Width="65"/>

    </Grid>
</Window>
